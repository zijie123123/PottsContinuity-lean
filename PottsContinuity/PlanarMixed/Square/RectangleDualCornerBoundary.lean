/- Adapted from FKconvergence, an earlier formalization by the same author that is not publicly
accessible (see `related_formalizations` in formalization.yaml): file
`FiniteFK/RectangleDualCornerBoundary.lean`.
Adaptation: namespace/import relocation; reuse existing PD/BD12 carriers.
Independent interior edge probability and every real q>=1 (PD.FK.Parameters).
No upper bound q<4 is used in this finite proof. -/
module

public import PottsContinuity.PlanarMixed.Square.RectangleDualCornerClamp
public import PottsContinuity.PlanarMixed.Square.FrozenBoundaryRetraction
public import PottsContinuity.PlanarMixed.Square.RectangleDoubleCollarDualBoundary
public import PottsContinuity.PlanarMixed.Square.Extras
public import Mathlib.Tactic
public import Mathlib.Algebra.Order.Ring.Star
public import Mathlib.Combinatorics.SimpleGraph.Maps
public import Mathlib.Data.Int.Star

@[expose] public section

namespace PottsContinuity.PlanarMixed.Square
open PD.FK PD.FK.Medial PD.Duality BD12
open scoped PottsContinuity.PlanarMixed.Square

open PD.FK PD.FK.Medial
noncomputable section

def rectangleDualCornerSideColumns (a : LatticeVertex) (w h : ℕ) :
    Set (RectangleVertex a w h) :=
  {v | v.1.1 = a.1 ∨ v.1.1 = a.1 + (w : ℤ)}

private theorem rectangleDualCornerClamp_mem_sideColumns
    (a : LatticeVertex) (w h : ℕ) (v : RectangleDualVertex a w h)
    (hv : v ∈ rectangleDoubleCollarDualInnerVerticalSides a w h) :
    rectangleDualCornerClamp a w h v ∈ rectangleDualCornerSideColumns a w h := by
  simp only [rectangleDoubleCollarDualInnerVerticalSides, Set.mem_ofPred_eq] at hv
  simp only [rectangleDualCornerSideColumns, Set.mem_ofPred_eq,
    rectangleDualCornerClamp_val]
  rcases hv with hleft | hright
  · left
    rw [hleft]
    simp
  · right
    rw [hright]
    simp

/-- The frozen actual dual boundary partition pulls back to no more wiring
than the two same-coordinate primal side columns. The proof uses only the
component-setoid relation generated by the actual frozen edges and boundary. -/
theorem rectangleDualCorner_frozenPartition_le_sideColumns
    (a : LatticeVertex) (w h : ℕ)
    (K : RemovedConfiguration (rectangleDualGraph a w h)
      (subgraphRemovedEdges
        ((rectangleDualCornerCoreGraph a w h).map
          (rectangleDualCornerCoreEmbedding a w h))
        (rectangleDualGraph a w h))) :
    (isolatedExtensionPullbackBoundary
      (rectangleDualCornerCoreEmbedding a w h)
      (frozenBoundary
        (BoundaryCondition.wired (rectangleDoubleCollarDualInnerVerticalSides a w h))
        K.val)).partition ≤
      (BoundaryCondition.wired (rectangleDualCornerSideColumns a w h)).partition := by
  classical
  let f := rectangleDualCornerCoreEmbedding a w h
  let r := rectangleDualCornerClamp a w h
  let ξ := BoundaryCondition.wired (rectangleDoubleCollarDualInnerVerticalSides a w h)
  let η := BoundaryCondition.wired (rectangleDualCornerSideColumns a w h)
  have hsection : ∀ u, r (f u) = u := by
    intro u
    exact rectangleDualCornerClamp_section a w h u
  have hξ : ∀ x y, ξ.partition.r x y → η.partition.r (r x) (r y) := by
    intro x y hxy
    rw [BoundaryCondition.wired_rel] at hxy
    rcases hxy with heq | ⟨hx, hy⟩
    · apply (BoundaryCondition.wired_rel _ _ _).2
      exact Or.inl (congrArg r heq)
    · apply (BoundaryCondition.wired_rel _ _ _).2
      exact Or.inr ⟨rectangleDualCornerClamp_mem_sideColumns a w h x hx,
        rectangleDualCornerClamp_mem_sideColumns a w h y hy⟩
  have hopen : ∀ x y, (openGraph (rectangleDualGraph a w h) K.val).Adj x y →
      η.partition.r (r x) (r y) := by
    intro x y hxy
    have hadj := hxy
    rw [openGraph_adj] at hxy
    simp only [openEdges, Set.mem_image] at hxy
    rcases hxy with ⟨e, heK, hexy⟩
    have hnot : e.1 ∉
        ((rectangleDualCornerCoreGraph a w h).map
          (rectangleDualCornerCoreEmbedding a w h)).edgeSet :=
      (mem_subgraphRemovedEdges e).mp (K.property heK)
    by_cases hout : ¬ (a.1 ≤ x.1.1 ∧ a.2 ≤ x.1.2) ∨
        ¬ (a.1 ≤ y.1.1 ∧ a.2 ≤ y.1.2)
    · have heq := rectangleDualCornerClamp_eq_of_adj_endpoint_outside a w h x y
        (openGraph_le _ _ hadj) hout
      exact (BoundaryCondition.wired_rel _ _ _).2 (Or.inl heq)
    · have hx : a.1 ≤ x.1.1 ∧ a.2 ≤ x.1.2 := by
        by_contra hn
        exact hout (Or.inl hn)
      have hy : a.1 ≤ y.1.1 ∧ a.2 ≤ y.1.2 := by
        by_contra hn
        exact hout (Or.inr hn)
      have hfx := rectangleDualCornerClamp_embedding_of_mem_corner a w h x hx.1 hx.2
      have hfy := rectangleDualCornerClamp_embedding_of_mem_corner a w h y hy.1 hy.2
      have hcore : (rectangleDualCornerCoreGraph a w h).Adj (r x) (r y) := by
        change (rectangleDualGraph a w h).Adj (f (r x)) (f (r y))
        rw [hfx, hfy]
        exact openGraph_le _ _ hadj
      have hmAdj :
          ((rectangleDualCornerCoreGraph a w h).map f).Adj (f (r x)) (f (r y)) :=
        (SimpleGraph.map_adj _ _ _ _).2 ⟨r x, r y, hcore, rfl, rfl⟩
      have hm : s(f (r x), f (r y)) ∈
          ((rectangleDualCornerCoreGraph a w h).map f).edgeSet :=
        ((rectangleDualCornerCoreGraph a w h).map f).mem_edgeSet.mpr hmAdj
      have heq : e.1 = s(f (r x), f (r y)) := by rw [hexy, hfx, hfy]
      exact False.elim (hnot (heq ▸ hm))
  have hle := componentSetoid_comap_le_of_retraction f r hsection ξ K.val η.partition hξ hopen
  intro u v huv
  change (Setoid.comap f (componentSetoid (rectangleDualGraph a w h) ξ K.val)).r u v at huv
  exact hle huv

end
end PottsContinuity.PlanarMixed.Square
