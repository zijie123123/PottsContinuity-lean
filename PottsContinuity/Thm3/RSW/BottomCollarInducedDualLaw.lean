module

public import PottsContinuity.Thm3.RSW.BottomCollarSourceState
public import PottsContinuity.Thm3.RSW.SelfDualSetup
public import PottsContinuity.DualityExt.PositiveWiredArcInducedLaw

@[expose] public section

namespace PottsContinuity.RSW
open PD.FK PD.Duality DualityExt
noncomputable section

/-- The actual residual dual graph of the bottom-collar construction, retaining
all host dual vertices and the original complementary sampled bonds. -/
abbrev bottomCollarInducedDualGraph (a : LatticeVertex) (w h : ℕ) :=
  rectangleSubgraphDualGraph (bottomCollar_source_map_le a w h)

/-- The actual complementary configuration bijection through the rectangular
bottom collar. The collar's fixed bonds are not sampled in this bijection. -/
def bottomCollarInducedDualEquiv (a : LatticeVertex) (w h : ℕ) :
    Configuration (rectangleGraph a w h) ≃
      Configuration (bottomCollarInducedDualGraph a w h) :=
  (isolatedExtensionConfigurationEquiv (rectangleGraph a w h)
    (FKC.FiniteFK.rectangleArbitraryBottomCollarEmbedding a w h)).trans
    (rectangleSubgraphDualConfigurationEquiv (bottomCollar_source_map_le a w h))

/-- The literal induced partition, generated by host exterior wiring and the
complementary state of the fixed bottom-collar bonds. -/
def bottomCollarInducedDualBoundary (a : LatticeVertex) (w h : ℕ) :
    BoundaryCondition (RectangleDualVertex (a.1,a.2-1) w (h+1)) :=
  embeddedSubgraphInducedDualBoundary
    (FKC.FiniteFK.rectangleArbitraryBottomCollarEmbedding a w h)
    (bottomCollar_source_map_le a w h)
    (bottomCollarSourceState a w h)

/-- At the explicit self-dual value this is an equality of the existing PD
FK laws for every real q at least one, without a dual-law interface premise. -/
theorem bottomCollar_induced_dual_law_at_selfDual (q : Set.Ici (1:ℝ))
    (a : LatticeVertex) (w h : ℕ) :
    (law (rectangleGraph a w h) (selfDualParameters q)
      (BoundaryCondition.wired {v : RectangleVertex a w h | v.val.2 = a.2})).map
      (bottomCollarInducedDualEquiv a w h) =
    law (bottomCollarInducedDualGraph a w h) (selfDualParameters q)
      (bottomCollarInducedDualBoundary a w h) := by
  exact positive_embedded_wiredArc_induced_duality_law_PD_at_selfDualParameter_of_sourcePartition
    (FKC.FiniteFK.rectangleArbitraryBottomCollarEmbedding a w h)
    (bottomCollar_source_map_le a w h) q _
    (bottomCollarSourceState a w h)
    (bottomCollarSourceState_partition a w h).symm

end
end PottsContinuity.RSW
