module

public import PottsContinuity.PD.RCInfinite.FiniteConditioning
public import Mathlib.Tactic
public import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected

@[expose] public section

namespace PottsContinuity.RSW
open PD.FK PD.RCInfinite MeasureTheory
noncomputable section
attribute [local instance] configurationMeasurableSpace

/-- For an arbitrary finite embedded domain, it suffices to check the boundary
partition generated by opening every exterior edge. -/
theorem embedded_exterior_partition_le_iff_fullExterior
    {U V : Type*} [Finite U] [Finite V]
    (G : SimpleGraph U) (H : SimpleGraph V) (f : U ↪ V)
    (ξ : BoundaryCondition V) (η : BoundaryCondition U) :
    (∀ K : RemovedConfiguration H (subgraphRemovedEdges (G.map f) H),
      (isolatedExtensionPullbackBoundary f (frozenBoundary ξ K.val)).partition ≤ η.partition) ↔
    (isolatedExtensionPullbackBoundary f
      (frozenBoundary ξ (subgraphRemovedEdges (G.map f) H))).partition ≤ η.partition := by
  constructor
  · intro h
    exact h ⟨_,Finset.Subset.refl _⟩
  · intro h K u v huv
    apply h
    change (componentSetoid H ξ K.val).r (f u) (f v) at huv
    exact componentSetoid_mono_edges_boundary _ _ le_rfl _ _ K.property huv

/-- Exterior-edge and original-wiring preservation of a separating equivalence
relation prove every required induced-partition upper bound. -/
theorem embedded_exterior_partition_le_of_separation
    {U V : Type*} [Finite U] [Finite V]
    (G : SimpleGraph U) (H : SimpleGraph V) (f : U ↪ V)
    (ξ : BoundaryCondition V) (η : BoundaryCondition U) (σ : Setoid V)
    (hξ : ξ.partition ≤ σ)
    (hcut : ∀ ⦃u v : V⦄,
      (openGraph H (subgraphRemovedEdges (G.map f) H)).Adj u v → σ.r u v)
    (hpull : Setoid.comap f σ ≤ η.partition) :
    ∀ K : RemovedConfiguration H (subgraphRemovedEdges (G.map f) H),
      (isolatedExtensionPullbackBoundary f (frozenBoundary ξ K.val)).partition ≤ η.partition := by
  apply (embedded_exterior_partition_le_iff_fullExterior G H f ξ η).mpr
  have hcomp : componentSetoid H ξ (subgraphRemovedEdges (G.map f) H) ≤ σ := by
    apply componentSetoid_le
    · intro u v hconn
      obtain ⟨p⟩ := (actualConnected_iff_walk _ _ u v).mp hconn
      induction p with
      | nil => exact σ.refl _
      | @cons u v w huv p ih => exact σ.trans (hcut huv) (ih p.reachable)
    · exact hξ
  intro u v huv
  exact hpull (hcomp huv)

end
end PottsContinuity.RSW
