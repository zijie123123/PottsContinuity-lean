module

public import PottsContinuity.DualityExt.PositiveRectangleSubgraphDuality
public import Mathlib.Tactic
public import Mathlib.Combinatorics.SimpleGraph.Basic
public import Mathlib.Probability.ProbabilityMassFunction.Constructions

/-!
# The induced dual law as a graph law

The remaining-edge law produced by rectangle conditioning is exactly the
positive FK law on the edge-deleted dual graph, with the boundary partition
generated by the rectangle's dual boundary and all forced-open dual bonds.
-/

@[expose] public section

namespace PottsContinuity.DualityExt

open PottsContinuity.PD.FK
open PottsContinuity.PD.FK.FiniteProbability
open PottsContinuity.PD.Duality

noncomputable section

variable {a : LatticeVertex} {w h : ℕ}
variable {G : SimpleGraph (RectangleVertex a w h)}

local instance dualSubgraphHostEdgeFintype :
    Fintype (rectangleDualGraph a w h).edgeSet := Fintype.ofFinite _
local instance dualSubgraphHostConfigFintype :
    Fintype (Configuration (rectangleDualGraph a w h)) := Fintype.ofFinite _
local instance dualSubgraphRemovedFintype (R : Configuration (rectangleDualGraph a w h)) :
    Fintype (RemovedConfiguration (rectangleDualGraph a w h) R) := Fintype.ofFinite _
local instance dualSubgraphRemainingFintype (R : Configuration (rectangleDualGraph a w h)) :
    Fintype (RemainingConfiguration (rectangleDualGraph a w h) R) := Fintype.ofFinite _

/-- For any finite graph, the FK law on the graph obtained by deleting an edge
set is the corresponding positive remaining-edge law. -/
theorem positive_law_edgeRestriction_map {V : Type*} [Finite V]
    {H : SimpleGraph V} {R : Configuration H}
    {q p : ℝ} (hq : 0 < q) (hp : 0 < p) (hp1 : p < 1)
    (ξ : BoundaryCondition V) :
    (positiveFKLaw (edgeRestriction H R) q p hq hp hp1 ξ).map
        (edgeRestrictionConfigurationEquiv H R) =
      positiveRemainingLaw q p hq hp hp1 ξ R := by
  classical
  let : Fintype H.edgeSet := Fintype.ofFinite _
  let : DecidableEq H.edgeSet := Classical.decEq _
  let : Fintype (edgeRestriction H R).edgeSet := Fintype.ofFinite _
  let : DecidableEq (edgeRestriction H R).edgeSet := Classical.decEq _
  let : Fintype (Configuration (edgeRestriction H R)) := Fintype.ofFinite _
  let : Fintype (RemainingConfiguration H R) := Fintype.ofFinite _
  have hweight (A : Configuration (edgeRestriction H R)) :
      positiveFKWeight (edgeRestriction H R) q p ξ A =
        positiveRemainingWeight q p ξ R (edgeRestrictionConfigurationEquiv H R A) := by
    rw [positiveFKWeight, positiveRemainingWeight, edgeRestriction_card,
      card_edgeRestrictionConfigurationEquiv, componentCount_edgeRestriction]
  unfold positiveFKLaw positiveRemainingLaw
  apply FiniteProbability.pmf_map_equiv_of_weight_eq
  intro A
  exact hweight A

/-- The graph dual to a rectangle edge subgraph: delete the duals of all
primal bonds absent from the subgraph, retaining all dual vertices. -/
abbrev rectangleSubgraphDualGraph (hG : G ≤ rectangleGraph a w h) :
    SimpleGraph (RectangleDualVertex a w h) :=
  edgeRestriction (rectangleDualGraph a w h) (rectangleSubgraphRemovedDualEdges hG)

/-- The natural configuration equivalence from a primal subgraph to its edge
dual, including the forced-open deleted dual bonds. -/
noncomputable def rectangleSubgraphDualConfigurationEquiv
    (hG : G ≤ rectangleGraph a w h) :
    Configuration G ≃ Configuration (rectangleSubgraphDualGraph hG) :=
  (rectangleSubgraphDualRemainingEquiv hG).trans
    (edgeRestrictionConfigurationEquiv (rectangleDualGraph a w h)
      (rectangleSubgraphRemovedDualEdges hG)).symm

/-- Positive-`q` free duality for every edge subgraph of a rectangle, with the
actual edge-deleted dual graph and its fully induced partition. -/
theorem positive_free_subgraph_duality_law
    (hG : G ≤ rectangleGraph a w h)
    {q p : ℝ} (hq : 0 < q) (hp : 0 < p) (hp1 : p < 1) :
    (positiveFKLaw G q p hq hp hp1 (BoundaryCondition.free ∅)).map
        (rectangleSubgraphDualConfigurationEquiv hG) =
      positiveFKLaw (rectangleSubgraphDualGraph hG) q (dualParameter q p) hq
        (dualParameter_pos hq hp hp1) (dualParameter_lt_one hq hp hp1)
        (frozenBoundary (rectangleDualBoundaryCondition a w h)
          (rectangleSubgraphRemovedDualEdges hG)) := by
  let K := rectangleSubgraphRemovedDualEdges hG
  let ξ := rectangleDualBoundaryCondition a w h
  let e := edgeRestrictionConfigurationEquiv (rectangleDualGraph a w h) K
  let e₁ := rectangleSubgraphDualRemainingEquiv hG
  have hleft := positive_free_subgraph_map_dual_remaining hG hq hp hp1
  have hright := positive_law_edgeRestriction_map
    (H := rectangleDualGraph a w h) (R := K) hq
    (dualParameter_pos hq hp hp1) (dualParameter_lt_one hq hp hp1)
    (frozenBoundary ξ K)
  have hremaining :
      (positiveFKLaw G q p hq hp hp1 (BoundaryCondition.free ∅)).map e₁ =
        (positiveFKLaw (rectangleSubgraphDualGraph hG) q (dualParameter q p)
          hq (dualParameter_pos hq hp hp1) (dualParameter_lt_one hq hp hp1)
          (frozenBoundary ξ K)).map e := by
    calc
      _ = positiveRemainingLaw q (dualParameter q p) hq
          (dualParameter_pos hq hp hp1) (dualParameter_lt_one hq hp hp1)
          (frozenBoundary ξ K) K := by simpa only [K, ξ] using hleft
      _ = _ := by simpa only [K, ξ, rectangleSubgraphDualGraph] using hright.symm
  ext A
  have hpoint := congrArg (fun μ : PMF
      (RemainingConfiguration (rectangleDualGraph a w h) K) => μ (e A)) hremaining
  have hpoint' : (positiveFKLaw G q p hq hp hp1 (BoundaryCondition.free ∅))
      (e₁.symm (e A)) =
      positiveFKLaw (rectangleSubgraphDualGraph hG) q (dualParameter q p)
        hq (dualParameter_pos hq hp hp1) (dualParameter_lt_one hq hp hp1)
        (frozenBoundary ξ K) A := by
    simpa only [FiniteProbability.map_equiv_apply, Equiv.symm_apply_apply] using hpoint
  change (positiveFKLaw G q p hq hp hp1 (BoundaryCondition.free ∅)).map
      (e₁.trans e.symm) A =
    positiveFKLaw (rectangleSubgraphDualGraph hG) q (dualParameter q p) hq
      (dualParameter_pos hq hp hp1) (dualParameter_lt_one hq hp hp1)
      (frozenBoundary ξ K) A
  calc
    _ = (positiveFKLaw G q p hq hp hp1 (BoundaryCondition.free ∅))
        (e₁.symm (e A)) := by
          rw [FiniteProbability.map_equiv_apply]
          rfl
    _ = positiveFKLaw (rectangleSubgraphDualGraph hG) q (dualParameter q p)
        hq (dualParameter_pos hq hp hp1) (dualParameter_lt_one hq hp hp1)
        (frozenBoundary ξ K) A := hpoint'

end
end PottsContinuity.DualityExt
