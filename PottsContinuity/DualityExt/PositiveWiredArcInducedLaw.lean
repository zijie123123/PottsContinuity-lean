module

public import PottsContinuity.DualityExt.PositiveConditionedSubgraphDuality
public import Mathlib.Tactic
public import Mathlib.Combinatorics.SimpleGraph.Maps
public import Mathlib.Probability.ProbabilityMassFunction.Constructions

@[expose] public section

namespace PottsContinuity.DualityExt

open PottsContinuity.PD.FK

noncomputable section

variable {a : LatticeVertex} {w h : ℕ}

/-- A wired boundary set transfers to the dual edge-restriction graph with
the partition generated by the host dual boundary and the forced-open bonds.
The source partition identity is the geometric input. -/
theorem positive_embedded_wiredArc_induced_duality_law_PD_at_selfDualParameter_of_sourcePartition
    {V : Type*} [Finite V] {J : SimpleGraph V}
    (f : V ↪ RectangleVertex a w h)
    (hJ : J.map f ≤ rectangleGraph a w h)
    (q : Set.Ici (1 : ℝ)) (A : Set V)
    (H : RemovedConfiguration (rectangleGraph a w h)
      (subgraphRemovedEdges (J.map f) (rectangleGraph a w h)))
    (hsource : (BoundaryCondition.wired A).partition =
      (isolatedExtensionPullbackBoundary f
        (frozenBoundary (BoundaryCondition.free ∅) H.val)).partition) :
    (law J (criticalParameters q) (BoundaryCondition.wired A)).map
        ((isolatedExtensionConfigurationEquiv J f).trans
          (rectangleSubgraphDualConfigurationEquiv hJ)) =
      law (rectangleSubgraphDualGraph hJ) (criticalParameters q)
        (frozenBoundary (rectangleDualBoundaryCondition a w h)
          (rectangleSubgraphDualOpenRemovedState hJ H).val) := by
  exact embedded_subgraph_conditioned_duality_law_PD_at_selfDualParameter_of_partition_eq
    f hJ q (BoundaryCondition.wired A) H hsource
    (frozenBoundary (rectangleDualBoundaryCondition a w h)
      (rectangleSubgraphDualOpenRemovedState hJ H).val) rfl

end

end PottsContinuity.DualityExt
