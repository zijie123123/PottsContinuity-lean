module

public import PottsContinuity.DualityExt.PositiveConditionedSubgraphDuality
public import PottsContinuity.DualityExt.PositivePDLawBridge
public import Mathlib.Tactic
public import Mathlib.Combinatorics.SimpleGraph.Maps
public import Mathlib.Probability.ProbabilityMassFunction.Constructions

@[expose] public section

namespace PottsContinuity.DualityExt

open PottsContinuity.PD.FK
open PottsContinuity.PD.Duality

noncomputable section

variable {a : LatticeVertex} {w h : ℕ}

/-- The boundary partition on the rectangle dual carrier generated by a
fixed state of the deleted primal bonds. -/
def embeddedSubgraphInducedDualBoundary
    {V : Type*} [Finite V] {J : SimpleGraph V}
    (f : V ↪ RectangleVertex a w h)
    (hJ : J.map f ≤ rectangleGraph a w h)
    (H : RemovedConfiguration (rectangleGraph a w h)
      (subgraphRemovedEdges (J.map f) (rectangleGraph a w h))) :
    BoundaryCondition (RectangleDualVertex a w h) :=
  frozenBoundary (rectangleDualBoundaryCondition a w h)
    (rectangleSubgraphDualOpenRemovedState hJ H).val

/-- Exact dual-law transfer for a finite source boundary condition when its
partition is realized by fixing the deleted bonds of a rectangular host.
The target boundary is the one generated by the complementary open dual
state of those bonds. -/
theorem positive_embedded_subgraph_induced_duality_law_of_sourcePartition
    {V : Type*} [Finite V] {J : SimpleGraph V}
    (f : V ↪ RectangleVertex a w h)
    (hJ : J.map f ≤ rectangleGraph a w h)
    {q p : ℝ} (hq : 0 < q) (hp : 0 < p) (hp1 : p < 1)
    (ξ : BoundaryCondition V)
    (H : RemovedConfiguration (rectangleGraph a w h)
      (subgraphRemovedEdges (J.map f) (rectangleGraph a w h)))
    (hsource : ξ.partition =
      (isolatedExtensionPullbackBoundary f
        (frozenBoundary (BoundaryCondition.free ∅) H.val)).partition) :
    (positiveFKLaw J q p hq hp hp1 ξ).map
        ((isolatedExtensionConfigurationEquiv J f).trans
          (rectangleSubgraphDualConfigurationEquiv hJ)) =
      positiveFKLaw (rectangleSubgraphDualGraph hJ) q (dualParameter q p) hq
        (dualParameter_pos hq hp hp1) (dualParameter_lt_one hq hp hp1)
        (embeddedSubgraphInducedDualBoundary f hJ H) := by
  simpa only [embeddedSubgraphInducedDualBoundary] using
    positive_embedded_subgraph_conditioned_duality_law_of_partition_eq
      f hJ hq hp hp1 ξ H hsource _ rfl

/-- PD-law form of the induced duality transfer for an arbitrary source
partition, at every admissible finite parameter record. -/
theorem positive_embedded_subgraph_induced_duality_law_PD_of_sourcePartition
    {V : Type*} [Finite V] {J : SimpleGraph V}
    (f : V ↪ RectangleVertex a w h)
    (hJ : J.map f ≤ rectangleGraph a w h)
    (θ : Parameters)
    (ξ : BoundaryCondition V)
    (H : RemovedConfiguration (rectangleGraph a w h)
      (subgraphRemovedEdges (J.map f) (rectangleGraph a w h)))
    (hsource : ξ.partition =
      (isolatedExtensionPullbackBoundary f
        (frozenBoundary (BoundaryCondition.free ∅) H.val)).partition) :
    (law J θ ξ).map
        ((isolatedExtensionConfigurationEquiv J f).trans
          (rectangleSubgraphDualConfigurationEquiv hJ)) =
      law (rectangleSubgraphDualGraph hJ) (dualParameters θ)
        (embeddedSubgraphInducedDualBoundary f hJ H) := by
  rw [← positiveFKLaw_eq_PD_law (θ := θ) (ξ := ξ)]
  rw [← positiveFKLaw_eq_PD_law (G := rectangleSubgraphDualGraph hJ)
    (θ := dualParameters θ) (ξ := embeddedSubgraphInducedDualBoundary f hJ H)]
  simpa only [dualParameters, edgeParameter,
    embeddedSubgraphInducedDualBoundary] using
    positive_embedded_subgraph_induced_duality_law_of_sourcePartition
      f hJ (clusterWeight_pos θ) (edgeParameter_pos θ) (edgeParameter_lt_one θ)
      ξ H hsource

end

end PottsContinuity.DualityExt
